#!/usr/bin/env bash

set -euo pipefail

REFERENCIA=${DOTFILES_REF:-main}
REMOTO=${DOTFILES_REMOTE:-https://github.com/rdiezsj/dotfiles.git}
DESTINO=${DOTFILES_HOME:-"$HOME/.dotfiles"}
ARCHIVO_SCRIPT=${BASH_SOURCE[0]:-}
DIRECTORIO_SCRIPT=
if [[ -n $ARCHIVO_SCRIPT && -f $ARCHIVO_SCRIPT ]]; then
  DIRECTORIO_SCRIPT=$(cd "$(dirname "$ARCHIVO_SCRIPT")" && pwd)
fi
OS_RELEASE=${DOTFILES_OS_RELEASE:-/etc/os-release}
ESCRITORIO=${DOTFILES_DESKTOP:-${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}}
SIMULACION=false
VAULT_SERVER=${DOTFILES_VAULT_SERVER:-}

while (( $# > 0 )); do
  case $1 in
    --dry-run) SIMULACION=true ;;
    --vault-server)
      VAULT_SERVER=${2:?Falta la URL tras --vault-server}
      shift
      ;;
  esac
  shift
done

mostrar_mensaje() {
  if [[ ${DOTFILES_DISABLE_GUM:-false} != true ]] && command -v gum >/dev/null 2>&1; then
    gum style --foreground 212 "$1"
  else
    printf '%s\n' "$1"
  fi
}

mostrar_encabezado() {
  local titulo=$1
  if [[ ${DOTFILES_DISABLE_GUM:-false} != true ]] && command -v gum >/dev/null 2>&1; then
    gum style --border double --padding '0 1' --foreground 212 "$titulo"
  else
    printf '\n+----------------------------------------+\n'
    printf '| %-38s |\n' "$titulo"
    printf '+----------------------------------------+\n'
  fi
}

mostrar_fase() {
  local titulo=$1
  if [[ ${DOTFILES_DISABLE_GUM:-false} != true ]] && command -v gum >/dev/null 2>&1; then
    gum style --border normal --padding '0 1' --foreground 39 "[>] $titulo"
  else
    printf '\n[>] %s\n' "$titulo"
  fi
}

ejecutar_fase() {
  local titulo=$1
  shift
  mostrar_fase "$titulo"
  if "$@"; then
    return 0
  fi
  registrar_resultado fallidos "$titulo: fase no completada"
  return 1
}

mostrar_plan_inicial() {
  mostrar_encabezado 'DOTFILES FEDORA -- PLAN INICIAL'
  if ! command -v git >/dev/null 2>&1; then
    mostrar_mensaje '[>] Instalar git mediante DNF para poder clonar el repositorio.'
  fi
  mostrar_mensaje "[>] Descargar y validar la referencia $REFERENCIA."
  mostrar_mensaje "[>] Crear $DESTINO solo si la referencia es compatible."
}

confirmar_plan_inicial() {
  local respuesta
  if [[ ${DOTFILES_DISABLE_GUM:-false} != true ]] && command -v gum >/dev/null 2>&1; then
    gum confirm '¿Deseas continuar con el plan inicial?'
    return
  fi
  read -r -p '--> ¿Deseas continuar con el plan inicial? [s/N] ' respuesta
  [[ ${respuesta,,} == s || ${respuesta,,} == si || ${respuesta,,} == sí ]]
}

ejecutar_instalador_remoto() {
  mostrar_plan_inicial
  if ! confirmar_plan_inicial; then
    printf '%s\n' 'Instalación cancelada antes de modificar el equipo.'
    return 0
  fi

  if ! command -v git >/dev/null 2>&1; then
    sudo dnf install -y git
  fi

  local temporal
  temporal=$(mktemp -d)
  if ! git clone --quiet --depth 1 --branch "$REFERENCIA" "$REMOTO" "$temporal"; then
    rm -rf "$temporal"
    return 1
  fi

  # shellcheck source=/dev/null
  source "$temporal/scripts/lib/validar-entorno-fedora.sh"
  if ! validar_entorno_fedora "$temporal/platforms/fedora/compatibility.env" "$OS_RELEASE" "$ESCRITORIO" >/dev/null; then
    rm -rf "$temporal"
    return 1
  fi

  if [[ -e $DESTINO ]]; then
    rm -rf "$temporal"
    printf 'El destino %s ya existe; no se ha modificado.\n' "$DESTINO" >&2
    return 1
  fi

  mv "$temporal" "$DESTINO"
  exec "$DESTINO/bootstrap" --desde-instalador
}

ejecutar_checkout_local() {
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/scripts/lib/validar-entorno-fedora.sh"
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/scripts/lib/resumen-bootstrap.sh"
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/platforms/fedora/dependencias.sh"
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/platforms/fedora/fuentes-externas.sh"
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/platforms/fedora/catalogo-software.sh"
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/platforms/fedora/multimedia-nvidia.sh"
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/platforms/fedora/scaffold.sh"
  # shellcheck source=/dev/null
  source "$DIRECTORIO_SCRIPT/platforms/fedora/vaultwarden.sh"
  validar_entorno_fedora "$DIRECTORIO_SCRIPT/platforms/fedora/compatibility.env" "$OS_RELEASE" "$ESCRITORIO"
  registrar_resultado presentes 'Entorno Fedora Workstation con GNOME validado'
  mostrar_encabezado 'DOTFILES FEDORA -- PLAN COMPLETO'
  mostrar_mensaje '[>] Comprobar dependencias mínimas y catálogos esenciales.'
  mostrar_mensaje '[>] Configurar Microsoft, RPM Fusion, software DNF/Flatpak y AppImage verificados.'
  mostrar_mensaje '[>] Sustituir Firefox y ONLYOFFICE por las variantes declaradas.'
  mostrar_mensaje '[>] Detectar NVIDIA, codecs multimedia y requisitos de reinicio de forma condicionada.'
  mostrar_mensaje '[>] Crear scaffold, plantillas Nautilus y configuración mínima de Dotbot.'
  mostrar_mensaje '[>] Instalar Bitwarden CLI y ofrecer la configuración opcional de Vaultwarden.'
  if [[ $SIMULACION == true ]]; then
    registrar_resultado omitidos 'Cambios de bootstrap en modo de simulación'
    mostrar_mensaje 'Simulación completada: no se ha modificado el equipo.'
    mostrar_resumen_final
    return 0
  fi
  if ! confirmar_plan_inicial; then
    printf '%s\n' 'Bootstrap cancelado antes de modificar el equipo.'
    return 0
  fi
  local hubo_fallos=false
  ejecutar_fase 'Dependencias mínimas' instalar_dependencias_minimas || hubo_fallos=true
  ejecutar_fase 'RPM Fusion Free y Nonfree' configurar_rpm_fusion "$DIRECTORIO_SCRIPT/catalogs/fuentes-externas.sh" || hubo_fallos=true
  ejecutar_fase 'Repositorio oficial de Microsoft y Firefox PWA' configurar_fuentes_catalogo "$DIRECTORIO_SCRIPT/platforms/fedora" "$DIRECTORIO_SCRIPT/platforms/fedora/compatibility.env" || hubo_fallos=true
  ejecutar_fase 'Homebrew y herramientas de compilación' instalar_homebrew || hubo_fallos=true
  ejecutar_fase 'Carpetas personales' crear_scaffold_personal "$DIRECTORIO_SCRIPT/config/scaffold/carpetas.sh" || hubo_fallos=true
  ejecutar_fase 'Plantillas de Nautilus' instalar_plantillas_nautilus "$DIRECTORIO_SCRIPT/config/nautilus-templates" || hubo_fallos=true
  ejecutar_fase 'Catálogo DNF, Flatpak y AppImage' ejecutar_catalogo_software "$DIRECTORIO_SCRIPT/catalogs" || hubo_fallos=true
  ejecutar_fase 'Multimedia y NVIDIA' configurar_multimedia_y_nvidia "$DIRECTORIO_SCRIPT/platforms/fedora/compatibility.env" || hubo_fallos=true

  if command -v bw >/dev/null 2>&1; then
    registrar_resultado presentes 'Bitwarden CLI ya estaba disponible'
  elif preparar_bitwarden_cli; then
    registrar_resultado instalados 'Bitwarden CLI instalado mediante Homebrew'
  else
    registrar_resultado pendientes 'Bitwarden CLI no pudo instalarse; Vaultwarden no se configuró'
  fi

  if command -v bw >/dev/null 2>&1; then
    if configurar_vaultwarden "$VAULT_SERVER"; then
      registrar_resultado instalados 'Sesión de Vaultwarden configurada'
    else
      codigo_vaultwarden=$?
      if (( codigo_vaultwarden == 2 )); then
        registrar_resultado omitidos 'Configuración de Vaultwarden omitida por la persona usuaria'
      else
        registrar_resultado pendientes 'Vaultwarden requiere una sesión válida'
      fi
    fi
  fi

  registrar_resultado instalados 'Dependencias mínimas comprobadas mediante DNF'
  if [[ $hubo_fallos == true || ${#RESULTADOS_FALLIDOS[@]} -gt 0 ]]; then
    printf '%s\n' '[!] Plan completado con incidencias; consulta el resumen.' >&2
  else
    printf '%s\n' '[OK] Plan completado.'
  fi
  mostrar_resumen_final
  [[ $hubo_fallos == false && ${#RESULTADOS_FALLIDOS[@]} -eq 0 ]]
}

if [[ -n $DIRECTORIO_SCRIPT && -f "$DIRECTORIO_SCRIPT/scripts/lib/validar-entorno-fedora.sh" ]]; then
  ejecutar_checkout_local
else
  ejecutar_instalador_remoto
fi
