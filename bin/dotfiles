#!/usr/bin/env bash

set -euo pipefail

uso() {
  printf '%s\n' 'Uso: dotfiles {doctor|update}' '  doctor: diagnóstico local de solo lectura.' '  update: actualiza el checkout y los gestores de la estación.'
}

if [[ $# == 1 && $1 == --help ]] || [[ $# == 2 && ( $1 == doctor || $1 == update ) && $2 == --help ]]; then
  uso
  exit 0
fi
if [[ $# != 1 || ( $1 != doctor && $1 != update ) ]]; then
  uso >&2
  exit 2
fi
RAIZ=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if [[ $1 == update ]]; then
  exec "$RAIZ/scripts/actualizar.sh"
fi
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' '[no comprobado] Falta Python 3 para ejecutar el diagnóstico.' >&2
  exit 2
fi
exec env PYTHONDONTWRITEBYTECODE=1 python3 "$RAIZ/scripts/doctor.py"
